{
  "manifest_version": 3,
  "name": "Pacifier",
  "version": "0.1.0",
  "description": "Ten calm YouTube videos from creators you chose. No recommendations, no autoplay, no cookies.",
  "minimum_chrome_version": "120",
  "action": {
    "default_title": "Open Pacifier",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png"
    }
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "options_page": "settings.html",
  "permissions": [
    "storage",
    "declarativeNetRequest"
  ],
  "host_permissions": [
    "https://www.youtube.com/*",
    "https://www.youtube-nocookie.com/*"
  ],
  "content_security_policy": {
    "extension_pages": "default-src 'self'; script-src 'self'; object-src 'none'; frame-src https://www.youtube-nocookie.com; connect-src https://www.youtube.com; img-src 'self'; style-src 'self'; base-uri 'none'; form-action 'none'"
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.youtube-nocookie.com/embed/*"
      ],
      "js": [
        "embed-filter.js"
      ],
      "all_frames": true,
      "run_at": "document_start"
    }
  ],
  "externally_connectable": {
    "ids": []
  }
}
